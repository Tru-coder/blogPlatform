DB_URL=postgresql+asyncpg://postgres:root@localhost:5434/blog_platform
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_PRIVATE_KEY_FILE_PATH=envs/private_key.pem
JWT_PUBLIC_KEY_FILE_PATH=envs/public_key.pem
JWT_ALGORITHM=RS512
JWT_ACCESS_EXPIRATION_IN_SECONDS=1800
JWT_REFRESH_EXPIRATION_IN_SECONDS=86400
JWT_ISSUER=blog_platform
JWT_AUDIENCE=users_blog_platform
JWT_REDIS_PREFIX=refresh_token:
JWT_LEEWAY_IN_SECONDS=10

SALT=some_long_and_strange_not_predicatble_string
PASSWORD_HASH_LENGTH=64
PASSWORD_SALT_LENGTH=64

# for tests
TEST_ASYNC_DB_URL=postgresql+asyncpg://postgres:root@localhost:5434/test_blog_platform